CHECK_DATABASE_URL=sqlite:///check.db
CHECK_BEARER_KEYS='{}'
CHECK_SIMULATOR_SECRET=
# demo uses synthetic sample PDFs. Set sarvam to enable merchant PDF extraction through the API.
CHECK_DOCUMENT_EXTRACTOR=demo
# Same-origin hosting needs no CORS configuration. Use comma-separated exact origins for split hosting.
CHECK_CORS_ORIGINS=
# Sarvam: live translation in the merchant app (empty = built-in Tamil/Hindi) and the Sarvam agent services.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Sandbox Relay Invoice Intake URL. Keep the complete URL secret.
RELAY_INTAKE_WEBHOOK_URL=
